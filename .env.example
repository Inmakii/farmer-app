DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins (scheme + host) trusted for HTTPS POST requests,
# e.g. https://farm.example.com. Leave empty for local development.
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS settings. Keep them False for local development over http://127.0.0.1:8000;
# set them to True in production only when the site is served over HTTPS.
# Accepted boolean values: true/false, 1/0, yes/no, on/off (anything else is an error).
# With DJANGO_SECURE_SSL_REDIRECT=True the cookie flags default to True;
# setting either of them to False together with the redirect is an error.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# HSTS max-age in seconds. Keep 0 until a real domain with working HTTPS is chosen;
# then raise it step by step (see docs/bezpieczenstwo_aplikacji.md).
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# MySQL is the only supported database. During tests Django creates and then
# drops a temporary database named test_farmer_db on the same MySQL server.
DB_NAME=farmer_db
DB_USER=farmer_app_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
